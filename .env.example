# Copy to .env for local runs:  cp .env.example .env
# The bridge loads .env automatically (real environment variables win).

# --- Dual-repo layout ---
# Factory repo (this repo): architecture, Master Specs, tasks.json, orchestration.
# Target repo (Repo B): all application code changes and pull requests.
# `python3 scripts/ai_bridge.py init` prompts for the repo name, creates it,
# and writes TARGET_REPO here automatically.
TARGET_REPO=your-username/your-clean-app-repo
# Optional workspace subdirectory the Actions workflow clones the target repo into.
# AI_BRIDGE_APP_DIR=app-workspace

# --- Local terminal (this machine) ---
# Architect / Product Owner planning is handled by Claude Code locally (CLAUDE.md).
# Claude Code uses its own local login; do NOT add any hosted LLM provider API key here.

# --- Cloud automation (GitHub Actions) ---
# Every automated background task runs on the economy route: PM decomposition,
# worker implementation, and PR review. One key covers all of them.
# Required GitHub repository secret: AI_ECONOMY_API_KEY
AI_ECONOMY_API_KEY=

# --- GitHub access ---
# Required in Actions as the AI_BRIDGE_PAT repository secret; also used locally by gh.
# AI_BRIDGE_PAT must be granted access to BOTH repositories:
#   - factory repo (this one): contents, issues, pull-requests, actions -> read/write
#   - target repo (Repo B): contents, pull-requests, actions -> read/write
# Do NOT look for a "checks" permission: fine-grained PATs cannot be granted Checks
# (https://github.com/orgs/community/discussions/129512). The review gate reads CI
# status from the Actions API instead. A classic PAT with repo + workflow also works.
# Without a PAT, PRs opened with GITHUB_TOKEN do not trigger CI/review workflows.
# Locally the gh CLI reads GH_TOKEN, so set it to the same PAT value.
GH_TOKEN=

# --- Optional overrides (defaults live in config/agents.json; leave unset normally) ---
# AI_ECONOMY_BASE_URL=https://api.deepseek.com/v1
# PM_MODEL=deepseek-chat
# WORKER_MODEL=deepseek-coder
# REVIEWER_MODEL=deepseek-chat

# Cost caps, concurrency, retries, and protected paths live in config/agents.json,
# not in this file. No other environment variables are read.
