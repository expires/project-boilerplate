{
  "version": 1,
  "governance": {
    "max_concurrency": 2,
    "max_open_prs": 2,
    "max_depth": 1,
    "review_retries": 3,
    "max_task_attempts": 2,
    "max_tasks_per_spec": 12,
    "require_ci_pass": true,
    "auto_merge": true,
    "lease_minutes": 45,
    "queue_file": "tasks.json"
  },
  "cost_controls": {
    "monthly_budget_usd": 25.0,
    "warn_at_percent": 80,
    "halt_on_budget_exceeded": true,
    "max_llm_calls_per_run": 12,
    "max_output_tokens_per_call": 8000,
    "max_input_chars": 48000,
    "max_pr_diff_lines": 600,
    "allow_premium_in_worker": false
  },
  "context": {
    "max_files_per_task": 8,
    "max_context_tokens": 32000,
    "chars_per_token": 4,
    "protected_paths": [
      ".github/workflows/**",
      "config/agents.json",
      "scripts/ai_bridge.py",
      "tasks.json",
      ".git/**",
      ".env",
      ".env.*",
      "**/secrets/**",
      "**/*.pem",
      "**/id_rsa*",
      "**/.npmrc",
      "**/.pypirc"
    ],
    "exclude_globs": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/__pycache__/**",
      "**/.venv/**"
    ]
  },
  "blind_collaboration": {
    "enabled": true,
    "strip_identity_terms": [
      "gpt",
      "chatgpt",
      "openai",
      "anthropic",
      "claude",
      "gemini",
      "deepseek",
      "llama",
      "mistral",
      "qwen",
      "grok",
      "copilot"
    ]
  },
  "labels": {
    "master_spec": "master-spec",
    "planned": "spec:planned",
    "auto_pr": "agent:auto",
    "escalation": "escalation",
    "architect": "agent:architect",
    "pipeline_halted": "pipeline:halted",
    "strike_prefix": "strike:",
    "routing": {
      "agent:frontend": "worker",
      "agent:backend": "worker",
      "agent:infra": "worker",
      "agent:test": "worker",
      "agent:docs": "worker"
    }
  },
  "escalation": {
    "close_pr": true,
    "delete_branch": false,
    "create_issue": true,
    "architect_github_login": ""
  },
  "branching": {
    "base_branch": "main",
    "branch_prefix": "agent/task-",
    "commit_prefix": "feat(agent)"
  },
  "roles": {
    "architect": {
      "provider": "premium",
      "model_env": "ARCHITECT_MODEL",
      "model_default": "gpt-4.1",
      "temperature": 0.2,
      "max_output_tokens": 4000,
      "timeout_seconds": 180
    },
    "pm": {
      "provider": "economy",
      "model_env": "PM_MODEL",
      "model_default": "deepseek-chat",
      "temperature": 0.2,
      "max_output_tokens": 4000,
      "timeout_seconds": 180
    },
    "worker": {
      "provider": "economy",
      "model_env": "WORKER_MODEL",
      "model_default": "deepseek-chat",
      "temperature": 0.1,
      "max_output_tokens": 8000,
      "timeout_seconds": 300
    },
    "reviewer": {
      "provider": "premium",
      "model_env": "REVIEWER_MODEL",
      "model_default": "gpt-4.1-mini",
      "temperature": 0.0,
      "max_output_tokens": 3000,
      "timeout_seconds": 180
    }
  },
  "providers": {
    "premium": {
      "base_url_env": "AI_PREMIUM_BASE_URL",
      "base_url_default": "https://api.openai.com/v1",
      "api_key_env": "AI_PREMIUM_API_KEY"
    },
    "economy": {
      "base_url_env": "AI_ECONOMY_BASE_URL",
      "base_url_default": "https://api.deepseek.com/v1",
      "api_key_env": "AI_ECONOMY_API_KEY"
    }
  },
  "pricing": {
    "premium": {
      "input_per_1k_usd": 0.002,
      "output_per_1k_usd": 0.008
    },
    "economy": {
      "input_per_1k_usd": 0.00014,
      "output_per_1k_usd": 0.00028
    }
  }
}
